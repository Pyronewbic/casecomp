{
  "manifest_version": 3,
  "name": "Casecomp – Queue Auto-Join",
  "version": "0.4.2",
  "description": "Auto-join Pokemon Center drop queues — detects waiting rooms, joins automatically, with live ETA and auto-checkout.",
  "permissions": [
    "notifications",
    "storage",
    "alarms",
    "proxy"
  ],
  "host_permissions": [
    "https://www.pokemoncenter.com/*",
    "https://pokemoncenter.com/*",
    "https://*.queue-it.net/*",
    "https://www.walmart.com/*",
    "https://www.costco.com/*",
    "https://www.target.com/*",
    "https://www.pokemoncenter-online.com/*",
    "https://pokemoncenter-online.com/*",
    "https://pokemoncenter.pokemon.co.jp/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://www.pokemon.com/*",
    "https://*.pokemon.com/*",
    "https://x.com/*",
    "https://www.reddit.com/*",
    "http://localhost:3099/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pokemoncenter.com/*",
        "https://pokemoncenter.com/*"
      ],
      "js": [
        "content/sites/pokemon-center.js",
        "content/queue-monitor.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pokemoncenter.com/*",
        "https://pokemoncenter.com/*"
      ],
      "js": [
        "content/sites/pokemon-center-listings.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pokemoncenter.com/*",
        "https://pokemoncenter.com/*",
        "https://www.walmart.com/*"
      ],
      "js": [
        "content/imap-autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "content/sites/discord.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.walmart.com/*",
        "https://*.queue-it.net/*"
      ],
      "js": [
        "content/sites/walmart-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.walmart.com/*",
        "https://*.queue-it.net/*"
      ],
      "js": [
        "content/sites/walmart.js",
        "content/queue-monitor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.costco.com/*"
      ],
      "js": [
        "content/sites/costco.js",
        "content/queue-monitor.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pokemoncenter-online.com/*",
        "https://pokemoncenter-online.com/*",
        "https://pokemoncenter.pokemon.co.jp/*"
      ],
      "js": [
        "content/sites/pokemon-center-jp.js",
        "content/queue-monitor.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.target.com/*"
      ],
      "js": [
        "content/sites/target.js",
        "content/queue-monitor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content/sites/x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3099/*"
      ],
      "js": [
        "content/sites/pokemon-center.js",
        "content/sites/pokemon-center-jp.js",
        "content/sites/walmart.js",
        "content/sites/costco.js",
        "content/sites/target.js",
        "content/queue-monitor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
